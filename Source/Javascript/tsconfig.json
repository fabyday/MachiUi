{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "jsx": "react",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "esModuleInterop": true
  },
  "ts-node": {
    "esm": true,
    "experimentalSpecifiers": true,
    "transpileOnly": true,
    "experimentalSpecifierResolution": "node",
    "compilerOptions": {
      "module": "ESNext"
    }
  },
  "files": ["./Native/native.d.ts"],
  "include": ["./webpack.config.ts", "./Reconciler/**/*", "./Native/**/*"]
}
